{
    "ver": "0.1.0",
    "authors": ["ac.shahnam"],
    "contact": "ac.shahnam",
    "categories": ["active", "assembly", "annotation"],
    "widgets": {
        "input": null,
        "output": "no-display"
    },
    "parameters": [
        {
            "id": "input_assembly_refs",
            "optional": false,
            "advanced": false,
            "allow_multiple": true,
            "default_values": [""],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": ["KBaseGenomeAnnotations.Assembly"]
            }
        },
        {
            "id": "lineage_mode",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": ["specific"],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {"value": "specific", "display": "Use the lineage dataset named below", "id": "specific", "ui_name": "Use the lineage dataset named below"},
                    {"value": "auto", "display": "Auto-select lineage (all domains)", "id": "auto", "ui_name": "Auto-select lineage (all domains)"},
                    {"value": "auto-prok", "display": "Auto-select lineage (prokaryotes only)", "id": "auto-prok", "ui_name": "Auto-select lineage (prokaryotes only)"},
                    {"value": "auto-euk", "display": "Auto-select lineage (eukaryotes only)", "id": "auto-euk", "ui_name": "Auto-select lineage (eukaryotes only)"}
                ]
            }
        },
        {
            "id": "lineage_dataset",
            "optional": true,
            "advanced": false,
            "allow_multiple": false,
            "default_values": ["bacteria_odb12.2"],
            "field_type": "text",
            "text_options": {}
        },
        {
            "id": "euk_predictor",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": ["miniprot"],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {"value": "miniprot", "display": "Miniprot (BUSCO default)", "id": "miniprot", "ui_name": "Miniprot (BUSCO default)"},
                    {"value": "metaeuk", "display": "MetaEuk", "id": "metaeuk", "ui_name": "MetaEuk"},
                    {"value": "augustus", "display": "Augustus (slowest)", "id": "augustus", "ui_name": "Augustus (slowest)"}
                ]
            }
        },
        {
            "id": "contig_break",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": ["10"],
            "field_type": "text",
            "text_options": {"validate_as": "int", "min_int": 0}
        },
        {
            "id": "evalue",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": ["0.001"],
            "field_type": "text",
            "text_options": {"validate_as": "float", "min_float": 0}
        },
        {
            "id": "limit",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": ["3"],
            "field_type": "text",
            "text_options": {"validate_as": "int", "min_int": 1}
        },
        {
            "id": "skip_bbtools",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": ["0"],
            "field_type": "checkbox",
            "checkbox_options": {"checked_value": 1, "unchecked_value": 0}
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "kb_busco",
            "method": "run_busco",
            "input_mapping": [
                {"narrative_system_variable": "workspace", "target_property": "workspace_name"},
                {"input_parameter": "input_assembly_refs", "target_property": "input_assembly_refs", "target_type_transform": "list<resolved-ref>"},
                {"input_parameter": "lineage_mode", "target_property": "lineage_mode"},
                {"input_parameter": "lineage_dataset", "target_property": "lineage_dataset"},
                {"input_parameter": "euk_predictor", "target_property": "euk_predictor"},
                {"input_parameter": "contig_break", "target_property": "contig_break"},
                {"input_parameter": "evalue", "target_property": "evalue"},
                {"input_parameter": "limit", "target_property": "limit"},
                {"input_parameter": "skip_bbtools", "target_property": "skip_bbtools"}
            ],
            "output_mapping": [
                {"service_method_output_path": [0, "report_name"], "target_property": "report_name"},
                {"service_method_output_path": [0, "report_ref"], "target_property": "report_ref"},
                {"narrative_system_variable": "workspace", "target_property": "workspace_name"}
            ]
        }
    },
    "job_id_output_field": "docker"
}
